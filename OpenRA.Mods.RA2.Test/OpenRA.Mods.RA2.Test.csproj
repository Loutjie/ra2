<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<EngineRootPath>../engine</EngineRootPath>
	</PropertyGroup>

	<Import Project="$(EngineRootPath)/Directory.Build.props" />

	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<IsPublishable>false</IsPublishable>
		<!-- Keep test binaries out of engine/bin so they never ship. -->
		<OutputPath>bin/Tests</OutputPath>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="../OpenRA.Mods.RA2/OpenRA.Mods.RA2.csproj" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
		<PackageReference Include="NUnit" Version="4.3.2" />
		<PackageReference Include="NUnit.Console" Version="3.19.0" />
		<PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
	</ItemGroup>

</Project>
